{
  "name": "@natlibfi/sfs-4900",
  "type": "module",
  "version": "3.0.0",
  "license": "MIT",
  "description": "Transliteration from cyrillic (Russian, Ukrainian) text to latin (Finnish) as defined in the SFS-4900 standard",
  "author": "The National Library of Finland",
  "contributors": [
    "Pasi Tuominen <pasi.tuominen@gmail.com>",
    "The National Library of Finland"
  ],
  "keywords": [
    "SFS-4900",
    "sfs4900",
    "standard",
    "romanization",
    "Russian",
    "Ukranian",
    "Finnish",
    "transliteration"
  ],
  "homepage": "https://www.npmjs.com/package/@natlibfi/sfs-4900",
  "bugs": {
    "url": "https://github.com/NatLibFi/sfs-4900/issues"
  },
  "repository": {
    "url": "https://github.com/NatLibFi/sfs-4900"
  },
  "main": "dist/transliteration.js",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "esbuild \"src/*.ts\" --sourcemap --platform=node --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ./src",
    "lint:dev": "eslint --fix ./src",
    "test": "npm run lint && npm run test:base",
    "test:base": "tsx --test --test-force-exit --experimental-test-coverage --test-reporter=spec test/*.test.ts",
    "dev:test": "cross-env DEBUG=@natlibfi/* NODE_ENV=test tsx --watch --test --experimental-test-coverage --test-reporter=spec src/*.test.ts src/**/*.test.ts"
  },
  "devDependencies": {
    "@natlibfi/fixugen": "^4.0.0",
    "@natlibfi/fixura": "^5.0.0",
    "@types/node": "^24.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.39.0"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.4"
    },
    "typescript-eslint": {
      "minimatch": "^11.0.4"
    }
  }
}
